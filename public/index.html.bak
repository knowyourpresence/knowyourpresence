  },
};

function applyLanguage(lang) {
  const dict = TRANSLATIONS[lang] || TRANSLATIONS.en;
  document.querySelectorAll("[data-i18n]").forEach((el) => {
    const key = el.getAttribute("data-i18n");
    if (dict[key]) el.innerHTML = dict[key];
  });
  document.querySelectorAll("[data-i18n-placeholder]").forEach((el) => {
    const key = el.getAttribute("data-i18n-placeholder");
    if (dict[key]) el.placeholder = dict[key];
  });
  document.documentElement.setAttribute("lang", lang);
  return dict;
}

window.KYP_I18N = { TRANSLATIONS, applyLanguage };

</script>
  <script>
const runScanBtn = document.getElementById("runScanBtn");
const inputCard = document.getElementById("inputCard");
const results = document.getElementById("results");
const rescanBtn = document.getElementById("rescanBtn");
const priceTag = document.getElementById("priceTag");

const SAMPLES = ["Greenish India NaturalCare", "Urban Bites Cafe", "Sharma Electronics"];

// --- currency symbols for client-side display (server does the real PPP calc) ---
const CURRENCY_SYMBOLS = {
  INR: "₹", USD: "$", GBP: "£", AUD: "A$", AED: "AED ", SAR: "SAR ",
  KWD: "KWD ", RUB: "₽", BRL: "R$", EUR: "€",
};

function scoreColor(score) {
  if (score >= 70) return "var(--green)";
  if (score >= 50) return "var(--amber)";
  return "var(--red)";
}

// --- language setup ---

// --- Real scan counter. Shows nothing until the backend says the count has
// passed its display threshold, so the number is always genuine rather than
// seeded with a fabricated starting figure.
(async function loadScanCounter() {
  const el = document.getElementById("scanCounter");
  if (!el) return;
  try {
    const res = await fetch("/api/stats/scans");
    const data = await res.json();
    if (data.visible && data.count) {
      el.textContent = `${data.count.toLocaleString()} businesses scanned so far`;
      el.hidden = false;
    }
  } catch {
    // Counter is decorative - stay silent and hidden if it fails
  }
})();

window.KYP_I18N.applyLanguage("en"); // English only - site targets English-speaking markets

// --- sample business buttons ---
const sampleRow = document.getElementById("sampleRow");
SAMPLES.forEach((name) => {
  const btn = document.createElement("button");
  btn.type = "button";
  btn.className = "sample-btn";
  btn.textContent = name;
  btn.onclick = () => {
    document.getElementById("businessNameInput").value = name;
    // Clear any place_id/city from a previous real Autocomplete selection -
    // otherwise a sample business name could get sent to the backend paired
    // with a stale, unrelated real business's place_id or city.
    selectedPlaceId = null;
    selectedCity = null;
    const confirmedEl = document.getElementById("placeConfirmed");
    if (confirmedEl) confirmedEl.hidden = true;
    runScan();
  };
  sampleRow.appendChild(btn);
});

// --- pricing: flat single price fetched from the backend (services/pricing.js).
// No country lookup - there is deliberately one price for every buyer.
async function updatePrice() {
  try {
    const res = await fetch("/api/pricing");
    const data = await res.json();
    const display = data.display || `$${data.price}`;
    priceTag.textContent = display;
    const heroPriceTag = document.getElementById("heroPriceTag");
    if (heroPriceTag) heroPriceTag.textContent = display;
  } catch (err) {
    console.error("Pricing fetch failed:", err);
    priceTag.textContent = "$129"; // matches REPORT_PRICE_USD in services/pricing.js
  }
}
updatePrice();


const yearEl = document.getElementById("year");
if (yearEl) yearEl.textContent = new Date().getFullYear();

// --- WhatsApp Link Generator (genuinely functional free tool) ---
const waBtn = document.getElementById("waGenerateBtn");
if (waBtn) {
  waBtn.addEventListener("click", () => {
    const raw = document.getElementById("waNumberInput").value.trim();
    const digitsOnly = raw.replace(/[^0-9]/g, "");
    const resultEl = document.getElementById("waResult");
    resultEl.hidden = false;
    if (digitsOnly.length < 8) {
      resultEl.innerHTML = "Enter a full number with country code (e.g. 919962337575).";
      return;
    }
    const link = `https://wa.me/${digitsOnly}`;
    resultEl.innerHTML = `Your link: <a href="${link}" target="_blank">${link}</a>`;
  });
}

// --- Auto-Reply Message Generator ---
const AUTO_REPLY_TEMPLATES = {
  friendly: {
    whatsapp: (biz) => `Hey there! 👋 Thanks for messaging ${biz || "us"}. We're away right now but we'll reply as soon as we're back - usually within a few hours. Talk soon!`,
    instagram: (biz) => `Hi! Thanks for reaching out to ${biz || "us"} 💛 We read every DM and will get back to you soon. In the meantime, check our latest posts for updates!`,
    facebook: (biz) => `Thanks for messaging ${biz || "us"}! We typically reply within a day. We appreciate you reaching out and can't wait to help. 😊`,
  },
  professional: {
    whatsapp: (biz) => `Thank you for contacting ${biz || "us"}. Our team is currently unavailable but will respond to your message within 24 hours during business days.`,
    instagram: (biz) => `Thank you for your message to ${biz || "us"}. We aim to respond to all inquiries within one business day.`,
    facebook: (biz) => `Thank you for reaching out to ${biz || "us"}. A member of our team will respond to your inquiry shortly during business hours.`,
  },
  fun: {
    whatsapp: (biz) => `Yo! 🙌 ${biz || "We"}'re off the grid for a sec but your message is locked in. We'll hit you back super soon!`,
    instagram: (biz) => `Heyyy 👋 thanks for sliding into our DMs at ${biz || "our page"}! We'll get back to you faster than you can say "double tap".`,
    facebook: (biz) => `Hey! Thanks for the message 🎉 ${biz || "We"} will be right with you - hang tight!`,
  },
};
const arBtn = document.getElementById("arGenerateBtn");
if (arBtn) {
  arBtn.addEventListener("click", () => {
    const bizType = document.getElementById("arBizType").value;
    const tone = document.getElementById("arTone").value;
    const bizTypeLabel = document.getElementById("arBizType").selectedOptions[0].text;
    const templates = AUTO_REPLY_TEMPLATES[tone];
    const resultEl = document.getElementById("arResult");
    resultEl.hidden = false;
    resultEl.innerHTML = `
      <div class="result-block"><span class="result-label">WhatsApp Away Message</span><span class="result-text">${templates.whatsapp(bizTypeLabel)}</span></div>
      <div class="result-block"><span class="result-label">Instagram Quick Reply</span><span class="result-text">${templates.instagram(bizTypeLabel)}</span></div>
      <div class="result-block"><span class="result-label">Facebook Instant Reply</span><span class="result-text">${templates.facebook(bizTypeLabel)}</span></div>
    `;
  });
}

// --- Google Business Post Generator ---
function gbpPostTemplates(name) {
  const biz = name || "your business";
  return [
    `📣 New week, new reasons to visit ${biz}! Come see what we've got waiting for you. 😊`,
    `⭐ Loving the support, ${biz} family! Thank you for every visit, review, and recommendation.`,
    `🕒 Reminder: we're open and ready for you today. Drop by ${biz} whenever suits you!`,
    `✨ Something new is happening at ${biz} - stop in this week to check it out.`,
    `💬 Have a question about ${biz}? Send us a message - we love hearing from you!`,
  ];
}
const gbpBtn = document.getElementById("gbpGenerateBtn");
if (gbpBtn) {
  gbpBtn.addEventListener("click", () => {
    const name = document.getElementById("gbpBizName").value.trim();
    const posts = gbpPostTemplates(name);
    const resultEl = document.getElementById("gbpResult");
    resultEl.hidden = false;
    resultEl.innerHTML = posts.map((p, i) => `<div class="result-block"><span class="result-label">Post idea ${i+1}</span><span class="result-text">${p}</span></div>`).join("");
  });
}

// --- QR Code Generator ---
const qrBtn = document.getElementById("qrGenerateBtn");
if (qrBtn) {
  qrBtn.addEventListener("click", () => {
    const url = document.getElementById("qrUrlInput").value.trim();
    const resultEl = document.getElementById("qrResult");
    const wrap = document.getElementById("qrCanvasWrap");
    if (!url) {
      resultEl.hidden = false;
      wrap.innerHTML = "Paste a link first (your WhatsApp link or Google review link).";
      document.getElementById("qrDownloadLink").style.display = "none";
      return;
    }
    wrap.innerHTML = "";
    try {
      const qr = qrcode(0, "M");
      qr.addData(url);
      qr.make();
      wrap.innerHTML = qr.createSvgTag(6, 0);
      resultEl.hidden = false;
      const svgEl = wrap.querySelector("svg");
      const svgData = new XMLSerializer().serializeToString(svgEl);
      const svgBlob = new Blob([svgData], { type: "image/svg+xml;charset=utf-8" });
      const svgUrl = URL.createObjectURL(svgBlob);
      const dlLink = document.getElementById("qrDownloadLink");
      dlLink.href = svgUrl;
      dlLink.download = "qr-code.svg";
      dlLink.style.display = "block";
      dlLink.textContent = "Download SVG";
    } catch (e) {
      wrap.innerHTML = "Couldn't generate a QR code for that input - try a shorter link.";
    }
  });
}

// --- Local Hashtag Generator ---
const HASHTAG_BASE = ["local", "smallbusiness", "supportlocal", "shopsmall", "instagood", "photooftheday"];
function generateHashtags(industry, city) {
  const ind = (industry || "business").toLowerCase().replace(/[^a-z0-9]/g, "");
  const cty = (city || "").toLowerCase().replace(/[^a-z0-9]/g, "");
  const tags = new Set();
  HASHTAG_BASE.forEach(t => tags.add(t));
  tags.add(ind);
  tags.add(ind + "life");
  tags.add(ind + "lover");
  tags.add(ind + "gram");
  if (cty) {
    tags.add(cty);
    tags.add(cty + ind);
    tags.add(ind + cty);
    tags.add(cty + "business");
    tags.add(cty + "local");
    tags.add("visit" + cty);
    tags.add(cty + "life");
  }
  tags.add(ind + "love");
  tags.add(ind + "daily");
  tags.add("small" + ind);
  return Array.from(tags).filter(Boolean).slice(0, 20);
}
const tagBtn = document.getElementById("tagGenerateBtn");
if (tagBtn) {
  tagBtn.addEventListener("click", () => {
    const industry = document.getElementById("tagIndustry").value.trim();
    const city = document.getElementById("tagCity").value.trim();
    const tags = generateHashtags(industry, city);
    const resultEl = document.getElementById("tagResult");
    resultEl.hidden = false;
    resultEl.innerHTML = tags.map(t => `<span class="hashtag-pill">#${t}</span>`).join(" ");
  });
}

// --- client-side mock scoring (this page is static-hosted, no backend) ---
// --- runs a real scan against the backend (server.js -> /api/scan) ---
let lastScanResult = null; // stashed here so the checkout form can reuse it
let selectedPlaceId = null; // set when the user picks a real business from Autocomplete - required for real Google data
let selectedCity = null; // extracted from the real address - used for Yelp and other city-scoped lookups

// --- Google Places Autocomplete: lets the user pick their EXACT business
// (disambiguating same-named businesses by address), instead of just typing
// a name with no way to resolve which real listing it refers to. ---
function initPlacesAutocomplete() {
  const input = document.getElementById("businessNameInput");
  const confirmedEl = document.getElementById("placeConfirmed");
  if (!input || !window.google || !google.maps || !google.maps.places) return;

  const autocomplete = new google.maps.places.Autocomplete(input, {
    types: ["establishment"],
    fields: ["place_id", "name", "formatted_address", "address_components"],
  });

  autocomplete.addListener("place_changed", () => {
    const place = autocomplete.getPlace();
    if (!place || !place.place_id) {
      selectedPlaceId = null;
      selectedCity = null;
      confirmedEl.hidden = true;
      return;
    }
    selectedPlaceId = place.place_id;
    input.value = place.name || input.value;
    confirmedEl.textContent = `✓ ${place.formatted_address || "Business confirmed"}`;
    confirmedEl.hidden = false;

    // Extract city from the real address components (the "locality" field) -
    // this is what lets us match the business on Yelp/other city-scoped
    // lookups without asking the customer to type their city separately.
    selectedCity = null;
    const components = place.address_components || [];
    const locality = components.find((c) => c.types.includes("locality"));
    const fallbackArea = components.find((c) => c.types.includes("administrative_area_level_2"));
    selectedCity = (locality || fallbackArea)?.long_name || null;
  });

  // If the user edits the name after selecting, the old place_id no longer
  // applies - clear it so we don't scan the wrong business.
  input.addEventListener("input", () => {
    selectedPlaceId = null;
    selectedCity = null;
    confirmedEl.hidden = true;
  });
}
// Called automatically by the Google Maps script's callback= parameter once it loads.
window.initPlacesAutocomplete = initPlacesAutocomplete;

async function runScan() {
  const businessName = document.getElementById("businessNameInput").value.trim() || "Sample Business";
  const emailInput = document.getElementById("scanEmailInput");
  const email = emailInput ? emailInput.value.trim() : "";
  const errorEl = document.getElementById("scanError");
  const dict = window.KYP_I18N.TRANSLATIONS.en;

  // Email gate - required before we spend real API money on a scan
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    if (errorEl) {
      errorEl.textContent = dict.scanEmailInvalid || "Please enter a valid email address to run your free scan.";
      errorEl.hidden = false;
    }
    if (emailInput) emailInput.focus();
    return;
  }
  if (errorEl) errorEl.hidden = true;

  runScanBtn.textContent = dict.scanning;
  runScanBtn.disabled = true;

  try {
    const res = await fetch("/api/scan", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        businessName,
        placeId: selectedPlaceId,
        email,
        city: selectedCity,
      }),
    });

    const data = await res.json();

    if (res.status === 429) {
      // Already used their free scan - show the server's message rather than
      // a generic failure, since this is expected behavior not an error.
      if (errorEl) {
        errorEl.textContent = data.message || "You've already used your free scan today.";
        errorEl.hidden = false;
      }
      return;
    }
    if (!res.ok) throw new Error(data.error || "Scan request failed");

    lastScanResult = data;
    renderResults(data);
  } catch (err) {
    console.error("Scan failed:", err);
    if (errorEl) {
      errorEl.textContent = dict.scanFailed || "Sorry, the scan couldn't run right now. Please try again in a moment.";
      errorEl.hidden = false;
    }
  } finally {
    runScanBtn.textContent = dict.runScan;
    runScanBtn.disabled = false;
  }
}

runScanBtn.addEventListener("click", runScan);

rescanBtn.addEventListener("click", () => {
  results.hidden = true;
  inputCard.hidden = false;
  document.getElementById("businessNameInput").value = "";
  selectedPlaceId = null;
  selectedCity = null;
  document.getElementById("placeConfirmed").hidden = true;
});

function renderResults(data) {
  inputCard.hidden = true;
  results.hidden = false;

  const dict = window.KYP_I18N.TRANSLATIONS.en;
  const gradeKeyMap = {
    Excellent: "gradeExcellent", Strong: "gradeStrong",
    "Needs Attention": "gradeNeeds", Critical: "gradeCritical",
  };

  document.getElementById("bizName").textContent = data.businessName;
  document.getElementById("gradeText").textContent = dict[gradeKeyMap[data.grade]] || data.grade;
  document.getElementById("potentialScore").textContent = data.potentialScore;

  const scoreNumberEl = document.getElementById("scoreNumber");
  const gauge = document.getElementById("gauge");
  const color = scoreColor(data.overall);

  let current = 0;
  const target = data.overall;
  const step = () => {
    current += 2;
    if (current > target) current = target;
    const deg = (current / 100) * 360;
    gauge.style.background = `conic-gradient(${color} ${deg}deg, var(--border) ${deg}deg)`;
    scoreNumberEl.textContent = current;
    if (current < target) requestAnimationFrame(step);
  };
  step();

  const breakdownEl = document.getElementById("breakdown");
  breakdownEl.innerHTML = "";
  data.breakdown.forEach((item) => {
    const div = document.createElement("div");
    div.className = "breakdown-item";
    div.innerHTML = `
      <div class="label">${item.category}</div>
      <div class="bar-bg"><div class="bar-fill" style="background:${scoreColor(item.score)}"></div></div>
      <div class="score-tag">${item.score}/100</div>
    `;
    breakdownEl.appendChild(div);
    requestAnimationFrame(() => { div.querySelector(".bar-fill").style.width = item.score + "%"; });
  });

  fillList("quickWins", data.actionPlan.quickWins);
  fillList("momentum", data.actionPlan.momentum);
  fillList("compound", data.actionPlan.compound);
}

function fillList(id, items) {
  const ul = document.getElementById(id);
  ul.innerHTML = "";
  if (!items || items.length === 0) {
    ul.innerHTML = "<li>Nothing urgent here - keep it up.</li>";
    return;
  }
  items.forEach((text) => {
    const li = document.createElement("li");
    li.textContent = text;
    ul.appendChild(li);
  });
}

// ============ CHECKOUT FLOW ============
const ctaBtn = document.getElementById("ctaBtn");
const checkoutOverlay = document.getElementById("checkoutOverlay");
const checkoutClose = document.getElementById("checkoutClose");
const checkoutEmail = document.getElementById("checkoutEmail");
const checkoutError = document.getElementById("checkoutError");
const checkoutPayBtn = document.getElementById("checkoutPayBtn");
const checkoutPriceTag = document.getElementById("checkoutPriceTag");

function openCheckout() {
  checkoutError.hidden = true;
  checkoutEmail.value = "";
  checkoutPriceTag.textContent = priceTag.textContent;
  checkoutOverlay.hidden = false;
}
function closeCheckout() {
  checkoutOverlay.hidden = true;
}

document.getElementById("checkoutBizType").addEventListener("change", (e) => {
  document.getElementById("checkoutDescWrap").hidden = e.target.value !== "other";
});

ctaBtn.addEventListener("click", openCheckout);
checkoutClose.addEventListener("click", closeCheckout);
checkoutOverlay.addEventListener("click", (e) => {
  if (e.target === checkoutOverlay) closeCheckout();
});

function isValidEmail(email) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
}

checkoutPayBtn.addEventListener("click", async () => {
  const email = checkoutEmail.value.trim();
  const businessName = lastScanResult ? lastScanResult.businessName : document.getElementById("businessNameInput").value.trim();
  const businessType = document.getElementById("checkoutBizType").value;
  const businessDescription = document.getElementById("checkoutDesc").value.trim();
  const waNumber = document.getElementById("checkoutWaNumber").value.trim().replace(/[^0-9]/g, "");
  const city = document.getElementById("checkoutCity").value.trim();
  const competitorName = document.getElementById("checkoutCompetitor").value.trim();
  // Scores come from the free scan already run - avoids re-running the scan at checkout time
  const scores = lastScanResult && lastScanResult.breakdown
    ? Object.fromEntries(lastScanResult.breakdown.map((b) => [b.category, b.score]))
    : null;
  // Real evidence (HTTPS, mobile-friendliness, real performance score, review
  // count, rating, photo count etc.) - captured here so the PAID report can
  // show genuine findings instead of numbers re-derived from the score alone.
  const scanDetails = lastScanResult ? lastScanResult.details : null;

  if (!isValidEmail(email)) {
    checkoutError.textContent = "Please enter a valid email address.";
    checkoutError.hidden = false;
    return;
  }

  checkoutPayBtn.disabled = true;
  checkoutPayBtn.textContent = "Preparing checkout...";
  checkoutError.hidden = true;

  try {
    // Create a Dodo checkout session on our backend, then send the customer
    // to Dodo's hosted checkout page.
    //
    // Unlike the old widget flow, fulfilment does NOT depend on this browser
    // staying open - Dodo's webhook confirms the payment server-side and
    // triggers the report + emails even if the customer closes the tab.
    const res = await fetch("/api/checkout/create-session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        businessName, email, businessType, businessDescription, city, waNumber, scores, scanDetails, competitorName,
      }),
    });
    const data = await res.json();
    if (!res.ok || !data.checkoutUrl) {
      throw new Error(data.error || "Could not start checkout.");
    }

    window.location.href = data.checkoutUrl; // hand off to Dodo's hosted page
  } catch (err) {
    checkoutError.textContent = err.message || "Something went wrong - please try again.";
    checkoutError.hidden = false;
    checkoutPayBtn.disabled = false;
    checkoutPayBtn.textContent = `Pay ${priceTag.textContent}`;
  }
});


</script>
</body>
</html>
