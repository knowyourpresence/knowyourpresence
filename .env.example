# Copy this file to .env and fill in your keys
# See README.md for how to get each one

PORT=3000

# Google Cloud Console -> enable "Places API" (New) and "PageSpeed Insights API"
GOOGLE_PLACES_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# Google Cloud Console -> enable "YouTube Data API v3" (free, public data)
YOUTUBE_API_KEY=

# Yelp Fusion API (yelp.com/developers) -> free tier available. Real public
# business data (rating, review count, claimed status) - no OAuth needed,
# same "public directory" pattern as Google Places. Particularly valuable
# for US/Canada, where Yelp is a major independent trust signal.
YELP_API_KEY=

# Meta Graph API - requires a Facebook App + the business's Page/Instagram
# Business account connected and a long-lived access token.
# https://developers.facebook.com/docs/graph-api/
META_ACCESS_TOKEN=

# Resend (resend.com) -> free tier covers 3,000 emails/month
RESEND_API_KEY=
# The "from" address emails are sent from - must be on a domain you've verified with Resend
EMAIL_FROM=reports@yourdomain.com
# Your own inbox - where new-sale notifications get sent
OWNER_EMAIL=you@yourdomain.com

# Anthropic API key (console.anthropic.com) - powers the AI content fallback
# for business types outside the 5 static buckets (restaurant/retail/salon/
# clinic/service). Optional: without it, "Other" business types just get the
# generic service-business template instead of tailored content.
ANTHROPIC_API_KEY=


# ---- Admin Dashboard ----
# Set a strong password. Access the dashboard at yourdomain.com/admin?key=YOURPASSWORD
ADMIN_PASSWORD=change_this_before_going_live

# ---- Meta Ads Library API (free, no business login needed) ----
# Shows any business's active Facebook/Instagram ads publicly.
# Setup: developers.facebook.com → create App → get App Access Token
# (App ID + App Secret → /oauth/access_token?grant_type=client_credentials)
# Then request "Ad Library API" access on your app dashboard.
META_ADS_ACCESS_TOKEN=

# ---- Apify (apify.com) ----
# Powers on-page SEO scraping and Google Maps public enrichment.
# Free tier: $5 credit/month (plenty for early KYP volume).
# Get token at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# ---- URLScan.io (urlscan.io) ----
# Security headers, tracker count, malicious flag, and homepage screenshot.
# Free tier: 5,000 public scans/day.
# Get key at: https://urlscan.io/user/signup
URLSCAN_API_KEY=
# Set to "private" once you upgrade to a paid plan (scans won't appear on public feed)
URLSCAN_VISIBILITY=public

# ---- Coupler.io (coupler.io) ----
# Pushes every completed scan + lead to Google Sheets / Airtable for analytics.
# Get API key at: https://app.coupler.io/ -> Account -> API
COUPLER_API_KEY=
# Create an importer in Coupler connected to your Google Sheet, paste its ID here
COUPLER_IMPORTER_ID=
# Optional: separate importer for leads (falls back to COUPLER_IMPORTER_ID if unset)
COUPLER_LEADS_IMPORTER_ID=

# ---- Dodo Payments (replaces Razorpay) ----
# Get these from app.dodopayments.com -> Developer -> API
DODO_PAYMENTS_API_KEY=
# Create your $129 report product in the Dodo dashboard, then paste its ID here.
# NOTE: the PRICE is set on the product in Dodo, not in this codebase.
DODO_PRODUCT_ID=
# Dodo dashboard -> Webhooks. Starts with whsec_
DODO_WEBHOOK_SECRET=
# test_mode while testing, live_mode when you go live
DODO_ENVIRONMENT=test_mode
# Your public URL, used to build report download links in emails
PUBLIC_BASE_URL=https://knowyourpresence.com
